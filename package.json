{
  "name": "foodtruck",
  "version": "0.1.0",
  "description": "API do foodtruck",
  "main": "src/server.ts",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.development --watch src/server.ts",
    "start": "node --env-file=.env.development src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f docker/compose.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.yml down",
    "migrate": "node --env-file=.env.development node_modules/node-pg-migrate/bin/node-pg-migrate.js -m src/infra/db/migrations -j sql",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks"
  }
}
